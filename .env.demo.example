POSTGRES_DB=bridgeflow
POSTGRES_USER=bridgeflow
POSTGRES_PASSWORD=replace-with-a-generated-demo-password
BRIDGEFLOW_SITE_ADDRESS=:80
BRIDGEFLOW_PUBLIC_ORIGIN=http://127.0.0.1:8082
BRIDGEFLOW_DEMO_GATEWAY_PORT=8082
BRIDGEFLOW_STORAGE_MAX_BYTES=10485760
BRIDGEFLOW_RETENTION_ENABLED=true
BRIDGEFLOW_RETENTION_ARCHIVED_PROJECT_DAYS=365
BRIDGEFLOW_RETENTION_CRON=0 30 2 * * *
BRIDGEFLOW_AI_PROVIDER=stub
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra
BRIDGEFLOW_AI_REDACT_TERMS=
BRIDGEFLOW_AI_MAX_INPUT_CHARACTERS=60000
BRIDGEFLOW_AI_MAX_CANDIDATES=25
BRIDGEFLOW_AI_MAX_QUESTIONS=8
BRIDGEFLOW_AI_MAX_CRITERIA=12
BRIDGEFLOW_AI_MAX_TEST_CASES=20
JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=75.0 -Djava.security.egd=file:/dev/urandom
